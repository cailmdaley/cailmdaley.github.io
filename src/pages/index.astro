---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'index');
const { Content } = await page.render();
---

<BaseLayout title="Home" description="Cail Daley — observational cosmologist at CEA Paris-Saclay, working on UNIONS cosmic shear, Euclid × CMB lensing, and verifiable AI-mediated science." mode={page.data.mode}>
  <section class="hero">
    <h1>{page.data.title}</h1>
    <p class="tagline">{page.data.subtitle}</p>
  </section>

  <section class="intro">
    <Content />
  </section>

  <section class="current">
    <h2>Current Work</h2>
    <ul class="work-list">
      <li>
        <a href="/research#optical-cosmic-shear" class="tag">optical</a>
        <span class="work-desc">UNIONS cosmic shear</span>
      </li>
      <li>
        <a href="/research#cmb--galaxy-cross-correlations" class="tag">cross-corr</a>
        <span class="work-desc">Euclid × SPT-3G cross-correlations</span>
      </li>
      <li>
        <a href="/research#kinematic-lensing" class="tag">spectroscopy</a>
        <span class="work-desc">Kinematic lensing</span>
      </li>
    </ul>
    <p class="links">
      <ProfileLinks />
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    margin-bottom: var(--space-md);
  }

  .hero h1 {
    margin-top: 0;
    margin-bottom: 0;
  }

  .tagline {
    color: var(--text-muted);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-top: 0;
  }

  .intro {
    margin-bottom: var(--space-md);
  }

  .intro :global(p) {
    text-indent: 0;
    font-size: 1rem;
    line-height: 1.7;
  }

  .intro :global(p + p) {
    margin-top: var(--space-sm);
  }

  .intro :global(p) {
    margin-bottom: 0;
  }

  .current h2 {
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .work-list {
    list-style: none;
    margin-left: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .work-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .work-list .tag {
    min-width: 6.6rem;
    text-align: center;
    border-bottom: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .work-list .tag:hover {
    background: rgba(71, 107, 107, 0.18);
    color: var(--text-primary);
  }

  .work-desc {
    font-variant-caps: all-petite-caps;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }

  .current .links {
    margin-top: var(--space-md);
    font-size: 1rem;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .work-list li {
      flex-wrap: wrap;
      gap: 0.25rem var(--space-sm);
    }

    .work-list .tag {
      font-size: 0.75rem;
    }

    .work-desc {
      font-size: 0.95rem;
    }
  }
</style>
