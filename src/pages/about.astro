---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'about');
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description="Cail Daley — postdoctoral researcher in observational cosmology at CosmoStat, CEA Paris-Saclay." mode={page.data.mode}>
  <div class="intro">
    <h1>{page.data.title}</h1>
    <div class="portrait">
      <img src="/portrait.jpg" alt="Cail Daley" />
    </div>
    <section class="bio">
      <Content />
    </section>
  </div>

  <section class="contact">
    <h2>Contact</h2>
    <p><a href="mailto:cail.daley@cea.fr">cail.daley@cea.fr</a></p>
    <p><ProfileLinks /></p>
  </section>

  </BaseLayout>

<style>
  h1 {
    margin-bottom: var(--space-lg);
  }

  /* The title and first two paragraphs sit beside the portrait; the rest run full width below it */
  .intro {
    display: grid;
    grid-template-columns: 1fr 46%;
    column-gap: var(--space-lg);
    align-items: start;
    margin-bottom: var(--space-lg);
  }

  .intro .bio {
    display: contents;
  }

  .intro > h1,
  .bio :global(p) {
    grid-column: 1;
  }

  .portrait {
    grid-column: 2;
    grid-row: 1 / span 3;
    margin: 0 0 var(--space-md);
  }

  .bio :global(p:nth-of-type(n+3)) {
    grid-column: 1 / -1;
  }

  .portrait img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  @media (max-width: 600px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .portrait {
      grid-row: 1;
      grid-column: 1;
      width: 60%;
      margin: 0 auto var(--space-lg);
    }

    .intro > h1 {
      grid-row: 2;
    }
  }

  .bio :global(p) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-primary);
    text-indent: 0;
  }

  /* grid items keep their margins (no collapsing), so each paragraph carries one gap below */
  .bio :global(p) {
    margin: 0 0 var(--space-md);
  }

  .contact {
    margin-bottom: 0;
  }

  .contact h2 {
    margin-bottom: var(--space-sm);
  }

  .contact p,
  .contact p + p {
    margin: 0.25rem 0;
    margin-bottom: 0;
    text-indent: 0;
  }

  </style>
