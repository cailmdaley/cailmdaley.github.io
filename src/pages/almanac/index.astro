---
import BaseLayout from '../../layouts/BaseLayout.astro';
import plate from '../../data/almanac-map.json';

// Each tool is one field on the map, in the order of plate.fields.tools.
const tools = [
  { name: 'felt', href: 'https://cailmdaley.github.io/felt/',
    html: `<a href="https://cailmdaley.github.io/felt/">felt</a> — searchable, connected Markdown notes that keep decisions and context across agent sessions.` },
  { name: 'Shuttle', href: 'https://github.com/cailmdaley/shuttle',
    html: `<a href="https://github.com/cailmdaley/shuttle">Shuttle</a> — agent orchestration across machines and HPC centres, with written tasks and a board for following the work.` },
  { name: 'hark', href: 'https://github.com/cailmdaley/hark',
    html: `<a href="https://github.com/cailmdaley/hark">hark</a> — live meeting transcription with speaker labels, written to a file an agent can follow.` },
  { name: 'UNIONS dashboard', href: 'https://unions-wl.github.io/production/status.html',
    html: `<a href="https://unions-wl.github.io/production/status.html">UNIONS production dashboard</a> — live progress of DR6 full-footprint shape-catalogue production.` },
  { name: 'ShapePipe', href: 'https://github.com/CosmoStat/shapepipe',
    html: `<a href="https://github.com/CosmoStat/shapepipe">ShapePipe</a> &amp; <a href="https://github.com/CosmoStat/sp_validation">sp_validation</a> — contributions to CosmoStat's galaxy-shape measurement and weak-lensing catalogue validation pipelines.` },
  { name: 'Lightcone tools', href: 'https://github.com/LightconeResearch',
    html: `<a href="https://github.com/LightconeResearch">Lightcone Research tools</a> — open-source tools for verifiable AI-mediated science, built with the core team.` },
  { name: 'B-mode report', href: 'https://github.com/cailmdaley/unions-bmodes-mystra',
    html: `<a href="https://github.com/cailmdaley/unions-bmodes-mystra">UNIONS B-mode MySTRA report</a> — a public report mirror for the agent-produced B-mode validation paper.` },
];

// Dated writing; the newest piece is the planted plot of the orchard.
const writing = [
  { name: 'Science & AI', href: '/almanac/science-ai', date: '2025-12-05', label: 'Dec 2025',
    html: `<a href="/almanac/science-ai">Science &amp; AI</a> — what happens when machine scientific output exceeds human verification, with an interactive graph of epistemic claims.` },
];

const [W, H] = plate.viewBox;
const at = ([x, y]: number[]) => `left:${(x / W * 100).toFixed(2)}%;top:${(y / H * 100).toFixed(2)}%`;
---

<BaseLayout title="Almanac" description="Things Cail Daley makes outside the research papers: tools for scientific pipelines and agent orchestration, and dated writing on AI and science." mode="blended">
  <figure class="plate" aria-label="A painted map of the almanac: tools and infrastructure as fields west of the creek, writing as an orchard to the east.">
    <div class="chart">
    <img src="/paint/almanac-map.webp" alt="" width={W} height={H} />
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      <path class="uncharted" d={plate.regions.uncharted.d} />
      <a href="#writing" tabindex="-1"><path class="region" d={plate.regions.writing.d} /></a>
      {plate.fields.tools.map((f, i) => (
        <a href={tools[i].href} tabindex="-1"><path class={`field f-tools-${i}`} d={f.d} /></a>
      ))}
      {plate.fields.writing.map((f, i) => (
        <a href={writing[i].href} tabindex="-1"><path class={`field f-writing-${i}`} d={f.d} /></a>
      ))}
      <g class="compass" transform={`translate(${W - 120} 92)`}>
        <circle r="34" />
        <path d="M0,-52 L7,0 L0,52 L-7,0 Z" />
        <path class="fill" d="M0,-52 L7,0 L-7,0 Z" />
        <path d="M-40,0 L40,0" />
        <text y="-60">N</text>
      </g>
    </svg>

    <a class="label region-label" href="#tools" style={at(plate.regions.tools.label)}>Tools &amp; infrastructure</a>
    <a class="label region-label" href="#writing" style={at(plate.regions.writing.label)}>Writing</a>
    <span class="label uncharted-label" style={at(plate.regions.uncharted.label)}>uncharted</span>
    {plate.fields.tools.map((f, i) => (
      <a class={`label field-label l-tools-${i}`} href={tools[i].href} style={at(f.label)}>{tools[i].name}</a>
    ))}
    {plate.fields.writing.map((f, i) => (
      <a class={`label field-label l-writing-${i}`} href={writing[i].href} style={at(f.label)}>
        {writing[i].name}<span class="year">{writing[i].date.slice(0, 4)}</span>
      </a>
    ))}
    </div>
    <h1 class="cartouche">Almanac</h1>
  </figure>

  <p class="intro">What I make around the science: the tools I build to get the work done, and writing on what changes when machines start doing science too.</p>

  <section id="tools">
    <h2>Tools &amp; infrastructure</h2>
    <ul class="entries">
      {tools.map((t) => <li set:html={t.html} />)}
    </ul>
  </section>

  <section id="writing">
    <h2>Writing</h2>
    <ul class="entries dated">
      {writing.map((w) => (
        <li>
          <time datetime={w.date}>{w.label}</time>
          <span set:html={w.html} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* The plate: printed onto the sheet, bleeding into its margins */
  .plate {
    position: relative;
    margin: 0 -1.6rem var(--space-lg);
  }

  .chart {
    position: relative;
  }

  .plate img {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }

  .plate svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .plate svg a {
    border: none;
  }

  /* Fields lift their colour under the pointer, as if glazed once more */
  .field,
  .region {
    fill: rgba(71, 107, 107, 0);
    stroke: rgba(70, 60, 50, 0);
    stroke-width: 2;
    mix-blend-mode: multiply;
    transition: fill 0.2s ease, stroke 0.2s ease;
    cursor: pointer;
  }

  .field:hover,
  .region:hover {
    fill: rgba(150, 110, 60, 0.16);
    stroke: rgba(70, 60, 50, 0.35);
  }

  .uncharted {
    fill: none;
    stroke: rgba(110, 103, 95, 0.5);
    stroke-width: 2;
    stroke-dasharray: 2 9;
    stroke-linecap: round;
  }

  .compass circle,
  .compass path {
    fill: none;
    stroke: rgba(70, 60, 50, 0.55);
    stroke-width: 1.6;
  }

  .compass .fill {
    fill: rgba(70, 60, 50, 0.45);
  }

  .compass text {
    font-family: var(--font-serif);
    font-size: 26px;
    text-anchor: middle;
    fill: rgba(46, 42, 38, 0.75);
  }

  /* Lettering */
  .cartouche {
    position: absolute;
    left: 5.5%;
    top: 4.2%;
    margin: 0;
    padding: 0.1rem 0.9rem 0.25rem;
    font-size: 2.1rem;
    letter-spacing: 0.08em;
    line-height: 1.1;
    background: rgba(242, 237, 227, 0.86);
    border: 1px solid rgba(126, 112, 98, 0.45);
    outline: 1px solid rgba(126, 112, 98, 0.25);
    outline-offset: 3px;
  }

  .label {
    position: absolute;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    border: none;
    line-height: 1.1;
    text-align: center;
    text-shadow:
      0 0 3px rgba(242, 237, 227, 0.95),
      0 0 6px rgba(242, 237, 227, 0.9),
      0 0 10px rgba(242, 237, 227, 0.7);
  }

  .region-label {
    font-size: 1.05rem;
    font-weight: 600;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.16em;
    color: var(--text-primary);
  }

  .field-label {
    white-space: normal;
    width: max-content;
    max-width: 6.5em;
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  .field-label .year {
    display: block;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .label:hover {
    color: var(--creek-wet);
  }

  .uncharted-label {
    font-size: 0.85rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.28em;
    color: var(--text-muted);
  }

  /* A label and its field light together */
  .plate:has(.l-tools-0:hover) .f-tools-0,
  .plate:has(.l-tools-1:hover) .f-tools-1,
  .plate:has(.l-tools-2:hover) .f-tools-2,
  .plate:has(.l-tools-3:hover) .f-tools-3,
  .plate:has(.l-tools-4:hover) .f-tools-4,
  .plate:has(.l-tools-5:hover) .f-tools-5,
  .plate:has(.l-tools-6:hover) .f-tools-6,
  .plate:has(.l-writing-0:hover) .f-writing-0 {
    fill: rgba(150, 110, 60, 0.16);
    stroke: rgba(70, 60, 50, 0.35);
  }

  /* The lists below are the full account */
  .intro {
    text-indent: 0;
    margin-bottom: var(--space-lg);
    color: var(--text-secondary);
  }

  section {
    margin: 0;
    scroll-margin-top: var(--space-lg);
  }

  section + section {
    margin-top: var(--space-lg);
  }

  h2 {
    font-size: 1.2rem;
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .entries {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    line-height: 1.6;
  }

  .entries li {
    margin-bottom: 0;
  }

  .dated li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: baseline;
  }

  .dated time {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-variant-numeric: lining-nums tabular-nums;
  }

  @media (max-width: 768px) {
    .plate {
      margin: 0 -0.8rem var(--space-lg);
    }

    .field-label {
      font-size: 0.72rem;
    }
  }

  /* Phone: the title steps out of the plate, and only the regions are lettered */
  @media (max-width: 600px) {
    .plate {
      display: flex;
      flex-direction: column;
      margin: 0 -0.5rem var(--space-md);
    }

    .cartouche {
      position: static;
      order: -1;
      align-self: flex-start;
      margin: 0 0.5rem var(--space-md);
      font-size: 1.8rem;
      padding: 0;
      background: none;
      border: none;
      outline: none;
    }

    .field-label,
    .uncharted-label {
      display: none;
    }

    .region-label {
      font-size: 0.82rem;
      letter-spacing: 0.1em;
    }

    .compass {
      display: none;
    }
  }
</style>
