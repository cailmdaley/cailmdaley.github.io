---
import BaseLayout from '../../layouts/BaseLayout.astro';

const agentic = [
  { html: `<a href="https://cailmdaley.github.io/felt/">felt</a> — searchable, connected Markdown notes that keep decisions and context across agent sessions.` },
  { html: `<a href="https://github.com/cailmdaley/shuttle">Shuttle</a> — agent orchestration across machines and HPC centres, with written tasks and a board for following the work.` },
  { html: `<a href="https://github.com/cailmdaley/hark">hark</a> — live meeting transcription with speaker labels, written to a file an agent can follow.` },
];

const science = [
  { html: `<a href="https://unions-wl.github.io/production/status.html">UNIONS production dashboard</a> — live progress of DR6 full-footprint shape-catalogue production.` },
  { html: `<a href="https://github.com/CosmoStat/shapepipe">ShapePipe</a> &amp; <a href="https://github.com/CosmoStat/sp_validation">sp_validation</a> — contributions to CosmoStat's galaxy-shape measurement and weak-lensing catalogue validation pipelines.` },
  { html: `<a href="https://arxiv.org/abs/2604.03227">UNIONS B-mode validation paper</a> — also published reproducibly as a <a href="https://myst-viewer.vercel.app/cailmdaley/unions-bmodes-mystra">MySTRA report</a>.` },
];

// Music by Claude: pieces and the instruments it builds to play them.
const music = [
  { html: `<a href="/almanac/instruments">Soundbench</a> — instruments written in code, for a person or a language model to play, and a banjo among them fitted to real recordings: a plate you can play, by Claude.` },
];

// Dated writing, newest first.
const writing = [
  { date: '2025-12-05', label: 'Dec 2025',
    html: `<a href="/almanac/science-ai">Science &amp; AI</a> — what happens when machine scientific output exceeds human verification, with an interactive graph of epistemic claims.` },
];

// The cover is also a map of its year: each of the year's entries marked at the time of year it happened, with a small drawing.
// Earlier years' entries stay off it; they are in the lists below with their year.
// Glyphs are drawn on a 24-unit square centred on the origin, in the cover's ink.
const marks = [
  { name: 'felt', href: 'https://cailmdaley.github.io/felt/', date: '2026-01-13',
    glyph: `<circle r="8" /><path d="M-7,-3.5 C-2,-6.5 3,-6.5 7.4,-2.6 M-8,0.8 C-3,-2.4 3,-2.4 8,1.6 M-6.2,5 C-2,2 2.4,2.2 6,5.6 M-3,-7.4 C-6,-2 -6,3 -3,7.4" /><path d="M6.2,5.2 C8.6,8 10.6,7.6 11,10.6" />` },
  { name: 'B-modes', href: 'https://arxiv.org/abs/2604.03227', date: '2026-04-03',
    glyph: `<circle r="10.5" class="faint" /><circle r="1.1" class="fill" /><path d="M5.6,-1.6 L3.8,3.6 M1.6,5.6 L-3.6,3.8 M-5.6,1.6 L-3.8,-3.6 M-1.6,-5.6 L3.6,-3.8 M9.6,-2.2 L7.6,5.2 M2.2,9.6 L-5.2,7.6 M-9.6,2.2 L-7.6,-5.2 M-2.2,-9.6 L5.2,-7.6" />` },
  { name: 'Shuttle', href: 'https://github.com/cailmdaley/shuttle', date: '2026-05-01',
    glyph: `<path d="M-11.5,0 C-7,-4.6 7,-4.6 11.5,0 C7,4.6 -7,4.6 -11.5,0 Z" /><path d="M-4.2,-1.4 H4.2 V1.4 H-4.2 Z" /><path d="M-2.6,0 H2.6" class="faint" /><path d="M4.2,0.4 C7,3.4 8,7 6.6,10.8" />` },
  { name: 'hark', href: 'https://github.com/cailmdaley/hark', date: '2026-09-24',
    glyph: `<path d="M-2.5,-10 C5,-10 8.5,-4.5 7,1 C6,4.5 2.5,5 2.5,8.5 C2.5,11 -0.5,11.6 -2.5,10.4" /><path d="M-1.5,-4.5 C1.5,-6 4,-3.5 2.6,-0.8 C1.6,1 -0.5,1.4 -0.2,3.4" /><path d="M-6.6,-3.6 C-8.6,-1.4 -8.6,1.4 -6.6,3.6 M-10.2,-6.4 C-13.2,-2.4 -13.2,2.4 -10.2,6.4" class="faint" />` },
  { name: 'Soundbench', href: '/almanac/instruments', date: '2026-11-10',
    glyph: `<path d="M-1.5,-2.2 L9.4,-10.4 M-0.2,-0.6 L10.6,-8.8" /><path d="M9.4,-10.4 L11.6,-12 L12.6,-10.4 L10.6,-8.8" /><circle cx="-4.8" cy="3.6" r="7.4" /><circle cx="-4.8" cy="3.6" r="5.4" class="faint" /><path d="M-7.4,6.6 L-3.2,1.6" />` },
];
// A mark's drawing sits at its day of the year, just outside the month names, with its name further out; the stylesheet sets how far.
const placed = marks.map((m) => {
  const d = new Date(m.date);
  const month = d.getUTCMonth(), days = new Date(Date.UTC(d.getUTCFullYear(), month + 1, 0)).getUTCDate();
  const deg = -105 + 30 * (month + (d.getUTCDate() - 0.5) / days);
  const a = deg * Math.PI / 180;
  const when = d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  return { ...m, when, cos: Math.cos(a).toFixed(4), sin: Math.sin(a).toFixed(4) };
});

// The title page is reckoned for the year the site was built.
const year = new Date().getFullYear();
const sinceLeap = year % 4;
const ordinal = ['', 'first', 'second', 'third'][sinceLeap];
const leapLine = sinceLeap ? `being the ${ordinal} after Leap Year` : 'being Leap Year';

// The month ring: January at the top, running clockwise like the year.
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
  'August', 'September', 'October', 'November', 'December'];
const CX = 500, CY = 500, R_TOP = 466, R_BOT = 493;
const ring = MONTHS.map((m, i) => {
  const deg = -90 + 30 * i;
  const top = Math.sin(deg * Math.PI / 180) <= 1e-9;
  // the top path starts at the bottom and runs clockwise; the bottom one starts at the top and runs back
  const frac = top ? (((deg - 90) % 360) + 360) % 360 / 360 : (((270 - deg) % 360) + 360) % 360 / 360;
  return { m, top, offset: `${(frac * 100).toFixed(3)}%` };
});
const circle = (r: number, sweep: 0 | 1) => {
  const y0 = sweep ? CY + r : CY - r, y1 = sweep ? CY - r : CY + r;
  return `M ${CX},${y0} A ${r} ${r} 0 1 ${sweep} ${CX},${y1} A ${r} ${r} 0 1 ${sweep} ${CX},${y0}`;
};
const ticks = MONTHS.map((_, i) => {
  const a = (-105 + 30 * i) * Math.PI / 180;
  const [r0, r1] = [447, 458];
  return `M ${(CX + r0 * Math.cos(a)).toFixed(1)},${(CY + r0 * Math.sin(a)).toFixed(1)} L ${(CX + r1 * Math.cos(a)).toFixed(1)},${(CY + r1 * Math.sin(a)).toFixed(1)}`;
}).join(' ');

---

<BaseLayout title="Almanacs" description="Cail Daley's almanacs, one a year: the agentic tools and science infrastructure he builds, music by Claude, and dated writing on AI and science." mode="blended">
  <p class="intro">An almanac is a compendium of useful information: astronomical data, forecasts, recipes, articles on current topics, folklore. When I was growing up on a farm in West Virginia, the farmer's almanac was always lying around. Below is my almanac of projects, thoughts, and explorations. Everything here is done in collaboration with, and largely written by, language models.</p>

  <header class="title-page">
    <p class="number">Number One</p>
    <h1>Almanac</h1>
    <p class="year">
      <svg class="glyph" viewBox="-12 -12 24 24" aria-hidden="true"><circle r="5.2" /><circle class="dot" r="1.3" /><path d="M0,-11V-8M0,8V11M-11,0H-8M8,0H11M-7.8,-7.8L-5.7,-5.7M5.7,5.7L7.8,7.8M-7.8,7.8L-5.7,5.7M5.7,-5.7L7.8,-7.8" /></svg>
      <span>for the Year {year}</span>
      <svg class="glyph" viewBox="-12 -12 24 24" aria-hidden="true"><path class="fill" d="M3,-7.42 A8,8 0 1,0 3,7.42 A7.69,7.69 0 0,1 3,-7.42 Z" /></svg>
    </p>
    <p class="leap">{leapLine}</p>

    <div class="roundel">
      <img src="/paint/almanac-cover.webp" width="800" height="800" alt="A painted roundel: the sun rising over misty violet and hemlock ridges, a waning crescent moon still up, seen over a porch rail." />
      <svg viewBox="0 0 1000 1000" aria-hidden="true">
        <defs>
          <path id="ring-top" d={circle(R_TOP, 1)} />
          <path id="ring-bot" d={circle(R_BOT, 0)} />
        </defs>
        <path class="ticks" d={ticks} />
        {ring.map((r) => (
          <text><textPath href={r.top ? '#ring-top' : '#ring-bot'} startOffset={r.offset} text-anchor="middle">{r.m}</textPath></text>
        ))}
      </svg>
      {placed.map((m) => (
        <a class="mark" href={m.href} style={`--cos: ${m.cos}; --sin: ${m.sin}`} title={`${m.name}, ${m.when}`}>
          <svg viewBox="-13 -13 26 26" aria-hidden="true" set:html={m.glyph} />
          <span>{m.name}</span>
        </a>
      ))}
    </div>

    <p class="contents">Containing the Tools of the Trade, the Infrastructure of the Sciences, a little Music, &amp; sundry Writings</p>
  </header>


  <section id="agentic">
    <h2>Agentic tools</h2>
    <ul class="entries">
      {agentic.map((t) => <li set:html={t.html} />)}
    </ul>
  </section>

  <section id="science">
    <h2>Science infrastructure</h2>
    <ul class="entries">
      {science.map((t) => <li set:html={t.html} />)}
    </ul>
  </section>

  <section id="music">
    <h2>Music</h2>
    <ul class="entries">
      {music.map((t) => <li set:html={t.html} />)}
    </ul>
  </section>

  <section id="writing">
    <h2>Writing</h2>
    <ul class="entries dated">
      {writing.map((w) => (
        <li>
          <time datetime={w.date}>{w.label}</time>
          <span set:html={w.html} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* ---- The title page: a rule-boxed almanac cover ---- */
  .title-page {
    --umber: #5E4A2E;
    --rule: rgba(110, 84, 46, 0.55);
    position: relative;
    text-align: center;
    margin: 0 0 var(--space-lg);
    padding: 1.4rem 1.6rem 1.5rem;
    border: 1px solid rgba(110, 84, 46, 0.6);
    outline: 1px solid rgba(110, 84, 46, 0.4);
    outline-offset: 4px;
    color: var(--text-primary);
  }

  /* The yellow cover: a gamboge glaze printed into the sheet */
  .title-page::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/paint/almanac-glaze.webp') center / 100% 100% no-repeat;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .title-page > * {
    position: relative;
  }

  .title-page p {
    text-indent: 0;
    margin: 0;
    line-height: 1.3;
  }

  .number {
    font-size: 0.82rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.32em;
    color: var(--umber);
    padding-bottom: 0.55rem;
    margin-bottom: 0.85rem !important;
    border-bottom: 1px solid var(--rule);
  }


  .title-page h1 {
    font-size: 3.4rem;
    letter-spacing: 0.1em;
    line-height: 1;
    margin: 0.1rem 0 0.35rem;
    padding-left: 0.1em; /* balance the trailing letter-space */
  }

  .year {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .glyph {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    fill: none;
    stroke: #8A5A1E;
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .glyph .dot,
  .glyph .fill {
    fill: #8A5A1E;
    stroke: none;
  }

  .glyph .fill {
    fill: #5F6E78;
  }

  .leap {
    font-size: 0.92rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.14em;
    color: var(--umber);
    margin-top: 0.15rem !important;
  }

  .roundel {
    position: relative;
    width: min(21rem, 100%);
    margin: 4.6rem auto 1.8rem;
    aspect-ratio: 1;
    --mark-r: 56%;
    --name-gap: 1.2rem;
  }

  /* The year's entries, each at the time of year it happened: the drawing on a ring just outside the months,
     the name beyond it on the same radius, so names never meet the month ring */
  .mark {
    position: absolute;
    left: calc(50% + var(--mark-r) * var(--cos));
    top: calc(50% + var(--mark-r) * var(--sin));
    transform: translate(-50%, -50%);
    display: block;
    color: var(--umber);
    border-bottom: none;
    z-index: 1;
  }

  .mark svg {
    display: block;
    width: 2.1rem;
    height: 2.1rem;
    fill: none;
    stroke: #8A5A1E;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  .mark svg :global(.faint) {
    stroke-width: 0.9;
    opacity: 0.7;
  }

  .mark svg :global(.fill),
  .mark svg :global(.dot) {
    fill: #8A5A1E;
    stroke: none;
  }

  /* the name's inner edge sits just beyond the drawing, along the radius */
  .mark span {
    position: absolute;
    left: calc(50% + var(--name-gap) * var(--cos));
    top: calc(50% + var(--name-gap) * var(--sin));
    transform: translate(calc(-50% + 50% * var(--cos)), calc(-50% + 50% * var(--sin)));
    font-size: 0.82rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .mark:hover,
  .mark:focus-visible {
    color: var(--text-primary);
  }

  .mark:hover svg,
  .mark:focus-visible svg {
    transform: scale(1.15);
  }

  .roundel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .roundel > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .roundel text {
    font-family: var(--font-serif);
    font-size: 30px;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.22em;
    fill: var(--umber);
  }

  .roundel .ticks {
    stroke: rgba(110, 84, 46, 0.75);
    stroke-width: 1.6;
    fill: none;
  }

  .contents {
    max-width: 24rem;
    margin: 0 auto !important;
    font-size: 1.02rem;
    font-variant-caps: small-caps;
    letter-spacing: 0.05em;
    color: var(--umber);
  }

  .intro {
    text-indent: 0;
    margin: 0 0 var(--space-lg);
  }

  /* ---- The lists: the full account ---- */
  section {
    margin: 0;
    scroll-margin-top: var(--space-lg);
  }

  section + section {
    margin-top: var(--space-lg);
  }

  h2 {
    font-size: 1.2rem;
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .entries {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    line-height: 1.6;
  }

  .entries li {
    margin-bottom: 0;
  }

  .dated li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: baseline;
  }

  .dated time {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* Phone: a narrower cover */
  @media (max-width: 600px) {
    .title-page {
      padding: 1rem 0.9rem 1.1rem;
    }

    .title-page h1 {
      font-size: 2.6rem;
    }

    .year {
      font-size: 1.1rem;
    }

    .roundel {
      width: 50%;
      margin-top: 4rem;
      margin-bottom: 3rem;
      --mark-r: 61%;
      --name-gap: 0.95rem;
    }

    .roundel text {
      font-size: 40px;
      letter-spacing: 0.1em;
    }

    .mark svg {
      width: 1.7rem;
      height: 1.7rem;
    }

    .mark span {
      font-size: 0.7rem;
      letter-spacing: 0.04em;
    }

  }
</style>
